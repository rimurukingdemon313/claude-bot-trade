# TradeLocker live account credentials (required).
# Set these in Railway's Environment Variables — never commit real values.
TRADELOCKER_EMAIL=you@example.com
TRADELOCKER_PASSWORD=your-tradelocker-password
TRADELOCKER_SERVER=YOURSERVER
TRADELOCKER_ACC_ID=1234567
TRADELOCKER_URL=https://demo.tradelocker.com/backend-api

# AI decision chain (chained fallback, tried in this order):
#   1. Gemini            (GEMINI_API_KEY)
#   2. Groq gpt-oss-120b  (GROQ_API_KEY)
#   3. Groq qwen3.8-27b   (GROQ_API_KEY, same key as above)
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
